# .gitignore

# Training memory skeleton is TRACKED in this framework repo (see .work.mlt/).
# Learner content under it may be committed deliberately (START_HERE.md §5) —
# but never commit secrets, large weights, or datasets. Lab virtualenvs are ignored:
.work.mlt/**/.venv/
.work.mlt/drills/.venv-*/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Models and weights (large files)
*.bin
*.pt
*.pth
*.safetensors
*.gguf
*.ggml
models/
checkpoints/

# Data
data/
datasets/
*.csv
*.parquet
*.jsonl

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment (templates like .env.example stay tracked)
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Temp
tmp/
.tmp/
temp/
